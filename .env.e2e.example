# Laravel Cashier local stack (see docker-compose.e2e.yml)
LARAVEL_PORT=8090
LARAVEL_URL=http://127.0.0.1:8090

# Cashier → host real-flow API (must include /api/v1)
ORCARAIL_BASE_URL=http://host.docker.internal:3000/api/v1
ORCARAIL_PAY_URL=http://host.docker.internal:5174
ORCARAIL_CURRENCY=usd

# Filled by bin/run-laravel-real-flow.sh from demo/.env.local + __real-flow/configure-woo
# ORCARAIL_API_KEY=
# ORCARAIL_API_SECRET=
# ORCARAIL_WEBHOOK_SECRET=
# ORCARAIL_TOKEN_ID=
# ORCARAIL_NETWORK_ID=
