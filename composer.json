{
    "name": "orcarail/cashier-orcarail",
    "description": "Laravel Cashier driver for OrcaRail — subscriptions, checkout, and webhooks for stablecoin payments",
    "type": "library",
    "license": "MIT",
    "homepage": "https://github.com/OrcaRail/sdks-laravel-cashier",
    "support": {
        "issues": "https://github.com/OrcaRail/sdks-laravel-cashier/issues",
        "source": "https://github.com/OrcaRail/sdks-laravel-cashier"
    },
    "keywords": [
        "laravel",
        "cashier",
        "orcarail",
        "billing",
        "subscriptions",
        "crypto",
        "stablecoin",
        "payments"
    ],
    "require": {
        "php": "^8.1",
        "ext-json": "*",
        "illuminate/contracts": "^10.0|^11.0|^12.0",
        "illuminate/database": "^10.0|^11.0|^12.0",
        "illuminate/http": "^10.0|^11.0|^12.0",
        "illuminate/routing": "^10.0|^11.0|^12.0",
        "illuminate/support": "^10.0|^11.0|^12.0",
        "orcarail/orcarail-php": "^1.0 || dev-main"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.0",
        "orchestra/testbench": "^8.0|^9.0|^10.0",
        "phpstan/phpstan": "^1.12 || ^2.0",
        "phpunit/phpunit": "^10.5 || ^11.0"
    },
    "autoload": {
        "psr-4": {
            "OrcaRail\\Cashier\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "OrcaRail\\Cashier\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "OrcaRail\\Cashier\\CashierServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse",
        "cs-check": "php-cs-fixer check --diff"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "php-http/discovery": true
        }
    },
    "repositories": [
        {
            "type": "path",
            "url": "../sdks-php",
            "options": {
                "symlink": true
            }
        }
    ],
    "minimum-stability": "dev",
    "prefer-stable": true
}
